    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "prisma": "5.22.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^6.0.3"
  }
