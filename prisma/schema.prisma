generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER")
  phone     String?
  phoneVerified Boolean @default(false)
  emailVerified Boolean @default(false)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorProfile        VendorProfile?
  events               Event[]
  organizerEvents      PublishedEvent[]     @relation("OrganizerEvents")
  favorites            Favorite[]
  eventWishlist        EventWishlist[]
  enquiriesAsCustomer  Enquiry[]           @relation("CustomerEnquiries")
  quotationsAsCustomer Quotation[]         @relation("CustomerQuotations")
  bookingsAsCustomer   Booking[]           @relation("CustomerBookings")
  eventReservations    TicketReservation[] @relation("CustomerReservations")
  eventOrders          TicketOrder[]       @relation("EventOrders")
  eventTickets         DigitalTicket[]     @relation("TicketHolder")
  checkInsPerformed    CheckIn[]           @relation("StaffCheckIns")
  reviews              Review[]
  messagesSent         Message[]           @relation("SentMessages")
  messagesReceived     Message[]           @relation("ReceivedMessages")
  notifications        Notification[]
  verificationAuditsAsAdmin VendorVerificationAudit[] @relation("VerificationAuditAdmin")

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  vendorCategories VendorCategory[]
  publishedEvents  PublishedEvent[]

  @@map("categories")
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  state     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  areas          Area[]
  vendorProfiles VendorProfile[]

  @@map("cities")
}

model Area {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  vendorProfiles VendorProfile[]

  @@map("areas")
}

model VendorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  slug            String   @unique
  description     String?
  longDescription String?
  subcategory     String?
  cityId          String?
  city            City?    @relation(fields: [cityId], references: [id])
  areaId          String?
  area            Area?    @relation(fields: [areaId], references: [id])
  address         String?
  phone           String?
  whatsapp        String?
  email           String?
  website         String?
  instagram       String?
  panNumber       String?
  gstin           String?
  businessRegistration String?
  phoneVerified   Boolean  @default(false)
  emailVerified   Boolean  @default(false)
  consentAt       DateTime?
  facebook        String?
  youtube         String?
  coverImage      String?
  logoImage       String?
  startingPrice   Int?
  status          String   @default("PENDING")
  isVerified      Boolean  @default(false)
  verificationStatus String @default("PENDING")
  verificationReason String?
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  isFeatured      Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  enquiryCount    Int      @default(0)
  bookingCount    Int      @default(0)
  responseTime    String?
  experienceYears Int?
  teamSize        Int?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories      VendorCategory[]
  portfolioImages PortfolioImage[]
  services        Service[]
  packages        Package[]
  availability    Availability[]
  enquiries       Enquiry[]           @relation("VendorEnquiries")
  quotations      Quotation[]         @relation("VendorQuotations")
  bookings        Booking[]           @relation("VendorBookings")
  reviews         Review[]
  favorites       Favorite[]
  subscription    VendorSubscription?
  featuredListing FeaturedListing?
  verificationDocuments VendorVerificationDocument[]
  verificationAudits VendorVerificationAudit[]

  @@map("vendor_profiles")
}

model VendorCategory {
  id         String        @id @default(cuid())
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])
  isPrimary  Boolean       @default(false)

  @@unique([vendorId, categoryId])
  @@map("vendor_categories")
}

model PortfolioImage {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  eventType String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@map("portfolio_images")
}

model Service {
  id          String        @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int?
  unit        String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@map("services")
}

model Package {
  id          String        @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int
  inclusions  String?
  isPopular   Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  quotationItems QuotationItem[]

  @@map("packages")
}

model Availability {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date      String
  isBlocked Boolean       @default(true)
  note      String?
  createdAt DateTime      @default(now())

  @@unique([vendorId, date])
  @@map("availability")
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  eventType   String
  city        String
  area        String?
  eventDate   String
  guestCount  Int
  totalBudget Int
  status      String   @default("PLANNING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services  EventService[]
  enquiries Enquiry[]

  @@map("events")
}

model EventService {
  id              String @id @default(cuid())
  eventId         String
  event           Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  serviceName     String
  allocatedBudget Int
  status          String @default("PENDING")

  @@map("event_services")
}

model Favorite {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, vendorId])
  @@map("favorites")
}

model Enquiry {
  id           String        @id @default(cuid())
  customerId   String
  customer     User          @relation("CustomerEnquiries", fields: [customerId], references: [id])
  vendorId     String
  vendor       VendorProfile @relation("VendorEnquiries", fields: [vendorId], references: [id])
  eventId      String?
  event        Event?        @relation(fields: [eventId], references: [id])
  eventType    String
  eventDate    String
  eventCity    String
  guestCount   Int
  budget       Int
  service      String
  requirements String?
  message      String?
  status       String        @default("SENT")
  viewedAt     DateTime?
  respondedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  quotations Quotation[]
  messages   Message[]

  @@map("enquiries")
}

model Quotation {
  id           String        @id @default(cuid())
  enquiryId    String
  enquiry      Enquiry       @relation(fields: [enquiryId], references: [id])
  vendorId     String
  vendor       VendorProfile @relation("VendorQuotations", fields: [vendorId], references: [id])
  customerId   String
  customer     User          @relation("CustomerQuotations", fields: [customerId], references: [id])
  subtotal     Int
  discount     Int           @default(0)
  taxes        Int           @default(0)
  extraCharges Int           @default(0)
  totalAmount  Int
  notes        String?
  terms        String?
  validUntil   String?
  status       String        @default("DRAFT")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items   QuotationItem[]
  booking Booking?

  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  packageId   String?
  package     Package?  @relation(fields: [packageId], references: [id])
  description String
  quantity    Int       @default(1)
  unitPrice   Int
  total       Int

  @@map("quotation_items")
}

model Booking {
  id               String        @id @default(cuid())
  quotationId      String        @unique
  quotation        Quotation     @relation(fields: [quotationId], references: [id])
  customerId       String
  customer         User          @relation("CustomerBookings", fields: [customerId], references: [id])
  vendorId         String
  vendor           VendorProfile @relation("VendorBookings", fields: [vendorId], references: [id])
  bookingAmount    Int
  commissionRate   Float         @default(8)
  commissionAmount Int
  vendorAmount     Int
  status           String        @default("CONFIRMED")
  eventDate        String
  eventType        String
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payments Payment[]
  review   Review?

  @@map("bookings")
}

model Payment {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  amount     Int
  currency   String   @default("INR")
  method     String?
  status     String   @default("PENDING")
  gatewayRef String?
  createdAt  DateTime @default(now())

  @@map("payments")
}

model Review {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id])
  customerId String
  customer   User          @relation(fields: [customerId], references: [id])
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id])
  rating     Int
  comment    String?
  eventType  String?
  isApproved Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@map("reviews")
}

model Message {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("SentMessages", fields: [fromId], references: [id])
  toId      String
  to        User     @relation("ReceivedMessages", fields: [toId], references: [id])
  enquiryId String?
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id])
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model VendorSubscription {
  id         String        @id @default(cuid())
  vendorId   String        @unique
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan       String        @default("FREE")
  validUntil DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("vendor_subscriptions")
}

model FeaturedListing {
  id        String        @id @default(cuid())
  vendorId  String        @unique
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime      @default(now())

  @@map("featured_listings")
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

model PublishedEvent {
  id                String   @id @default(cuid())
  organizerId       String
  organizer         User     @relation("OrganizerEvents", fields: [organizerId], references: [id])
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  slug              String   @unique
  name              String
  description       String
  coverImage        String?
  venueName         String
  venueAddress      String
  city              String
  state             String?
  country           String   @default("India")
  latitude          Float?
  longitude         Float?
  startsAt          DateTime
  endsAt            DateTime
  timezone          String   @default("Asia/Kolkata")
  cancellationPolicy String?
  terms             String?
  status            String   @default("DRAFT")
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  images            EventImage[]
  ticketTypes       TicketType[]
  reservations      TicketReservation[]
  orders            TicketOrder[]
  wishlistEntries   EventWishlist[]

  @@index([status, startsAt])
  @@index([organizerId, status])
  @@index([categoryId, status])
  @@map("published_events")
}

model EventImage {
  id        String         @id @default(cuid())
  eventId   String
  event     PublishedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([eventId, sortOrder])
  @@map("event_images")
}

model TicketType {
  id               String         @id @default(cuid())
  eventId          String
  event            PublishedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  price            Int
  quantity         Int
  soldQuantity     Int            @default(0)
  heldQuantity     Int            @default(0)
  availableQuantity Int
  salesStart       DateTime?
  salesEnd         DateTime?
  minimumQuantity  Int            @default(1)
  maximumQuantity  Int            @default(10)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  reservationItems TicketReservationItem[]
  orderItems       TicketOrderItem[]
  tickets          DigitalTicket[]

  @@index([eventId, sortOrder])
  @@map("ticket_types")
}

model EventWishlist {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     PublishedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, eventId])
  @@map("event_wishlist")
}

model TicketReservation {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation("CustomerReservations", fields: [userId], references: [id])
  eventId        String
  event          PublishedEvent         @relation(fields: [eventId], references: [id])
  status         String                 @default("HELD")
  expiresAt      DateTime
  idempotencyKey String                 @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  items          TicketReservationItem[]
  order          TicketOrder?

  @@index([eventId, status, expiresAt])
  @@index([userId, createdAt])
  @@map("ticket_reservations")
}

model TicketReservationItem {
  id            String            @id @default(cuid())
  reservationId String
  reservation   TicketReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType        @relation(fields: [ticketTypeId], references: [id])
  quantity      Int

  @@unique([reservationId, ticketTypeId])
  @@map("ticket_reservation_items")
}

model TicketOrder {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation("EventOrders", fields: [userId], references: [id])
  eventId         String
  event           PublishedEvent    @relation(fields: [eventId], references: [id])
  reservationId   String?           @unique
  reservation     TicketReservation? @relation(fields: [reservationId], references: [id])
  idempotencyKey  String            @unique
  status          String            @default("PENDING")
  subtotal        Int
  discount        Int               @default(0)
  totalAmount     Int
  currency        String            @default("INR")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items           TicketOrderItem[]
  tickets         DigitalTicket[]
  payments        EventPayment[]
  refunds         EventRefund[]

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@map("ticket_orders")
}

model TicketOrderItem {
  id           String     @id @default(cuid())
  orderId      String
  order        TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  unitPrice    Int
  total        Int

  @@map("ticket_order_items")
}

model DigitalTicket {
  id           String      @id @default(cuid())
  orderId      String
  order        TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  holderId     String?
  holder       User?       @relation("TicketHolder", fields: [holderId], references: [id])
  attendeeName String?
  attendeeEmail String?
  token        String      @unique
  status       String      @default("VALID")
  checkedInAt  DateTime?
  createdAt    DateTime    @default(now())

  checkIn      CheckIn?

  @@index([orderId])
  @@index([ticketTypeId, status])
  @@map("digital_tickets")
}

model EventPayment {
  id             String      @id @default(cuid())
  orderId        String
  order         TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String      @default("INR")
  gateway        String
  gatewayOrderId String?
  gatewayPaymentId String?
  status         String      @default("PENDING")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@map("event_payments")
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  gateway        String
  gatewayEventId String   @unique
  eventType      String
  payload        String
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([gateway, eventType])
  @@map("payment_webhook_events")
}

model EventRefund {
  id             String      @id @default(cuid())
  orderId        String
  order          TicketOrder @relation(fields: [orderId], references: [id])
  amount         Int
  reason         String?
  gatewayRef     String?
  status         String      @default("REQUESTED")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([orderId, status])
  @@map("event_refunds")
}

model CheckIn {
  id          String        @id @default(cuid())
  ticketId    String        @unique
  ticket      DigitalTicket @relation(fields: [ticketId], references: [id])
  staffId     String
  staff       User          @relation("StaffCheckIns", fields: [staffId], references: [id])
  checkedInAt DateTime      @default(now())

  @@index([staffId, checkedInAt])
  @@map("check_ins")
}

model VendorVerificationDocument {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentType String
  storagePath  String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  status       String   @default("PENDING")
  rejectionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendorId, status])
  @@map("vendor_verification_documents")
}

model VendorVerificationAudit {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User     @relation("VerificationAuditAdmin", fields: [adminId], references: [id])
  action      String
  fromStatus  String?
  toStatus    String?
  reason      String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([vendorId, createdAt])
  @@map("vendor_verification_audits")
}
