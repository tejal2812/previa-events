# Supabase PostgreSQL. Use the pooler URL for DATABASE_URL and the direct
# database URL for migrations in DIRECT_URL.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Eventora"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
RAZORPAY_KEY_ID="replace-with-razorpay-key-id"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="PREVIA EVENTS <tickets@example.com>"